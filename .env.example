# Copy this file to .env and set your key. Never commit .env.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-north1.nebius.com/v1/
NEBIUS_MODEL=zai-org/GLM-5.3
# GLM-5.3 accepts text only; keep a vision model for puzzle and answer-key images.
NEBIUS_VISION_MODEL=zai-org/GLM-5.3-Flash
MODEL_TIMEOUT_SECONDS=180
MODEL_MAX_TOKENS=10000
# Optional: enter verified per-million-token prices to calculate estimated cost.
# INPUT_PRICE_PER_MILLION=
# OUTPUT_PRICE_PER_MILLION=
# VISION_INPUT_PRICE_PER_MILLION=
# VISION_OUTPUT_PRICE_PER_MILLION=
